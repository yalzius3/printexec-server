# ── Core (required) ─────────────────────────────────────────────────────────
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ALLOWED_ORIGIN=
PORT=
# Set to "production" in prod: it is what flags the upload-session cookie as
# Secure (HTTPS-only). Railway/Nixpacks usually sets it, but verify.
NODE_ENV=

# ── Supabase Storage ─────────────────────────────────────────────────────────
# Bucket holding all uploaded files (gcode/STL/attachments/logos).
# Default: "uploads".
SUPABASE_UPLOAD_BUCKET=

# ── Customer auto-emails ─────────────────────────────────────────────────────
# "true" attempts real delivery, anything else = dry-run (compose + log only).
# Sweep cadence in ms (default 120000 = 2 min).
EMAIL_ENABLED=
EMAIL_SWEEP_INTERVAL_MS=
# No-reply sender identity (one-way notifications; no Reply-To is set). The
# address must be on a domain verified with the provider.
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=
# Resend API key (https://resend.com) — required when EMAIL_ENABLED=true.
RESEND_API_KEY=
# Canonical public origin of the APP, used for every link in outbound email
# (CTA buttons + the company logo at /api/uploads/logo/:companyId).
# Defaults to https://solution.printexec.xyz.
#
# This deliberately does NOT read ALLOWED_ORIGIN: that var holds whatever
# origin the API serves CORS for, which is often a pinned Cloudflare preview
# (e.g. https://<hash>.printexec-client.pages.dev). Preview hashes are fine for
# CORS and wrong in email — they're not the address customers should see and
# they go stale. Only set this if the public app address actually moves.
EMAIL_APP_URL=
# Legacy/general public app origin. No longer used for email links (see
# EMAIL_APP_URL above); kept for any non-email consumer.
PUBLIC_APP_URL=

# ── Payments (checkout) ──────────────────────────────────────────────────────
# Payment processor behind POST /licensing/checkout. "none" (default) keeps
# checkout offline: plan choices are recorded (selected_plan_code) and the
# client shows "payments open soon" copy. When the Payoneer integration lands
# it registers as "payoneer" in src/licensing/payments.service.ts and takes
# its credentials from PAYONEER_* below.
PAYMENT_PROVIDER=
# Reserved for the Payoneer pass (unused while PAYMENT_PROVIDER=none):
PAYONEER_API_KEY=
PAYONEER_WEBHOOK_SECRET=

# ── Licensing / plans ────────────────────────────────────────────────────────
# "true" makes the license guard actually block read-only workspaces; anything
# else = dry-run (logs what WOULD be blocked, never blocks). Leave unset until
# a payment provider is wired up.
LICENSING_ENFORCED=
# Trial and grace windows in days (defaults: 14 / 14).
LICENSE_TRIAL_DAYS=
LICENSE_GRACE_DAYS=
# Comma-separated email allowlist for the platform-admin area
# (/api/licensing/admin — plan assignment, grant codes). Empty = nobody.
PLATFORM_ADMIN_EMAILS=

# ── Invoice drafts (ProArt hand-off) ────────────────────────────────────────
# PrintExec is a product of ProArt Consulting, and ProArt is the legal entity
# that invoices customers under its own tax-authority serial numbers. Invoices
# this platform generates are therefore DRAFTS and are never emailed to a
# tenant automatically — they go to this address instead, for you to pass to
# ProArt. Once ProArt returns the finalized document you attach it to the
# draft in the admin console and send it from there.
# Unset = drafts are still recorded (and still not sent to tenants), but you
# get no email about them.
INVOICE_DRAFT_EMAIL=

# ── Platform-admin step-up auth (REQUIRED to use the admin area) ─────────────
# The licensing admin sets plans, printer caps, custom pricing, grant codes and
# discounts, so it is gated by TWO factors: an allow-listed email (above) AND
# this passphrase. Entering it in the app mints a short-lived, signed session
# bound to that admin; every admin request must carry it.
#
#   !! FAIL-CLOSED: if PLATFORM_ADMIN_SECRET is unset the admin area is
#   !! DISABLED entirely (a wide-open billing console is never the fallback).
#   !! Use a long random string, e.g. `openssl rand -base64 36`.
#
# Rotating it immediately invalidates every live admin session (the session
# signing key is derived from it + the service-role key).
PLATFORM_ADMIN_SECRET=
# How long an unlocked admin session lasts (minutes, default 30).
PLATFORM_ADMIN_SESSION_MINUTES=
# Failed unlock attempts before a cooling-off lockout, and its length in
# minutes (defaults: 5 attempts / 15 minutes).
PLATFORM_ADMIN_MAX_ATTEMPTS=
PLATFORM_ADMIN_LOCKOUT_MINUTES=
# Owner license notices (trial ending/ended, renewal due, lapsed, read-only).
# On by default; set "false" to disarm the sweep entirely. Real delivery still
# rides EMAIL_ENABLED (off = dry-run compose + log). Cadence default 6 h; the
# lookback caps how far past a lapse a notice still sends vs. being skipped
# as stale backlog (default 10 days).
LICENSE_NOTICES_ENABLED=
LICENSE_NOTICE_SWEEP_INTERVAL_MS=
LICENSE_NOTICE_LOOKBACK_DAYS=

# ── Object storage deletion (MASTER SWITCH) ─────────────────────────────────
# "true" lets the app actually delete bytes from the bucket; anything else =
# dry-run. OFF BY DEFAULT, and deliberately so.
#
# Every delete path funnels through StorageFilesService: deleting an order, a
# piece, a bulk selection, an attachment, a bed, or a whole tenant. Before this
# existed the bucket was write-only and leaked; now it does not, which also
# means one bug here is a bug that destroys customer files across every tenant
# at once.
#
# In dry-run every path still runs its full reference check (the guard that
# stops a deleted piece taking its duplicates' G-code with it) and logs the
# exact keys it WOULD have removed:
#
#   [dry-run] STORAGE_DELETE_ENABLED is not "true" — would delete N object(s): ...
#
# Leave it off for a week, read those lines against real traffic, and only then
# set it to "true". Nothing is reclaimed until you do — including the existing
# backlog and any deleted tenant's files.
#
# NOTE: the retention sweep below needs BOTH this and PURGE_ENABLED. It unlinks
# DB references before removing bytes, so running it with this off would strand
# the objects permanently.
STORAGE_DELETE_ENABLED=

# ── File retention purge ─────────────────────────────────────────────────────
# "true" actually deletes fulfilled-order gcode/STL past the retention window;
# anything else = dry-run (logs what WOULD be purged). Retention in days
# (default 25); sweep cadence in ms (default 21600000 = 6 h).
PURGE_ENABLED=
PURGE_FULFILLED_DAYS=
PURGE_SWEEP_INTERVAL_MS=

# ── AI analyst (dashboard "Ask" / Lorelei) ───────────────────────────────────
# Feature is off unless AI_ANALYST_ENABLED=true AND AI_API_KEY AND AI_MODEL are
# all set. Provider:
#   openai     — any /chat/completions-compatible API (OpenAI, Groq, vLLM, …)
#   openrouter — OpenRouter (OpenAI-compatible + real per-call cost accounting)
#   anthropic  — Anthropic /v1/messages
# AI_BASE_URL overrides the provider default endpoint (openrouter defaults to
# https://openrouter.ai/api/v1). AI_MAX_TOKENS is per model round (default 3000
# — roomy so a compose_report artifact never truncates mid-call).
#
# Wire Claude Sonnet 5 as Lorelei via OpenRouter:
#   AI_ANALYST_ENABLED=true
#   AI_PROVIDER=openrouter
#   AI_API_KEY=sk-or-...              # your OpenRouter key
#   AI_MODEL=anthropic/claude-sonnet-5
AI_ANALYST_ENABLED=
AI_PROVIDER=
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_MAX_TOKENS=
# Optional OpenRouter attribution (shown on your OpenRouter dashboard).
AI_OPENROUTER_REFERER=
AI_OPENROUTER_TITLE=

# ── AI analyst spend budget ──────────────────────────────────────────────────
# Per-CALENDAR-MONTH cap on real model spend, metered from the provider's
# reported per-call cost (OpenRouter usage.cost) or a token-price estimate, and
# resetting on the 1st of each month. When the month's spend reaches the cap,
# "Ask" returns 429 until it resets. The cap is INTERNAL — the client only ever
# sees a 0–100% meter, never the dollar figure. Requires
# migrations/2026-07-15_ai_usage_budget.sql — until it's applied the cap is NOT
# enforced (fails open, logs a warning).
#   AI_BUDGET_USD    monthly cap in USD (default 1; set 0 to disable the cap)
#   AI_BUDGET_SCOPE  "company" (DEFAULT — each tenant gets its own independent
#                    cap, so one workspace can't drain everyone else's) or
#                    "global" (a single shared cap across the whole deploy)
# Token-price estimate fallback (defaults = Claude Sonnet 5 list price, $/1M):
#   AI_PRICE_INPUT_PER_MTOK  (default 3)
#   AI_PRICE_OUTPUT_PER_MTOK (default 15)
AI_BUDGET_USD=
AI_BUDGET_SCOPE=
AI_PRICE_INPUT_PER_MTOK=
AI_PRICE_OUTPUT_PER_MTOK=
